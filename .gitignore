# Entornos virtuales
.venv/
venv/
env/

# Dataset raw (imágenes originales del TNO, ~15 MB)
data/raw/*
# (se excluye el CONTENIDO y no el directorio: git no desciende a un directorio excluido,
#  de modo que una negacion dentro de el nunca se aplicaria)
# ...pero SÍ se versiona el manifiesto: md5 y procedencia exacta de cada archivo en el
# TNO original (figshare 1008029), para que el corpus sea verificable y reconstruible.
!data/raw/MANIFIESTO_CORPUS.csv

# Imágenes procesadas y resultados generados
data/processed/
experiments/results/fused_images/
# metrics_reports SÍ se versiona: respalda las tablas y la estadística de la tesis (Apéndice C)
experiments/results/metrics_reports/*.png
experiments/results/metrics_reports/*.html

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/

# Jupyter
.ipynb_checkpoints/

# Editores
.vscode/
.idea/
*.swp
*~

# Windows
Thumbs.db
desktop.ini

# Backups locales de documentos (no versionar)
docs/*_BACKUP*.docx
docs/*_BACKUP*.pptx
docs/*BACKUP*.docx

# Datos comprimidos / dataset
data/*.zip
*.zip

# Archivos temporales de previsualización y mensajes de commit
.git_commit_msg.txt
docs/_preview*.pdf
docs/_pv_*.png
docs/_av_*.png
docs/_dv_*.png
docs/_chk_*.png

# Pesos y artefactos de YOLO/entrenamiento
*.pt
runs/
experiments/results/detection_train/
# pso SÍ se versiona: estados/checkpoints que documentan las corridas (Tabla 2, Figura 13)
experiments/results/applications/

